# ─── FutureKawa — Back Brazil — Variables d'environnement ────────────────────
# Copier ce fichier en .env et adapter les valeurs si nécessaire.
# Les valeurs ci-dessous sont utilisables directement pour une démo locale.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=futurekawa_br
POSTGRES_USER=futurekawa_br_user
POSTGRES_PASSWORD=futurekawa-demo-2025

# Port publié sur l'hôte (accès direct depuis l'extérieur du conteneur).
# L'API utilise le réseau Docker interne (postgres:5432) — cette variable
# ne sert qu'à exposer PostgreSQL sur la machine hôte pour l'inspection.
POSTGRES_PORT=5433

# ── MQTT ──────────────────────────────────────────────────────────────────────
# Port publié sur l'hôte pour les clients MQTT externes (ex : ESP32, tests).
# Si un autre broker utilise déjà 1883 sur la machine, choisir un autre port
# (ex : 1885) et reporter la même valeur dans server/.env et dans le firmware.
MQTT_PORT=1883

# Adresse d'écoute du broker sur l'hôte.
#   127.0.0.1 (défaut) : seuls les programmes de la machine peuvent publier.
#   0.0.0.0            : un ESP32 du même réseau peut publier (démo réelle).
# Accès anonyme : n'utiliser 0.0.0.0 que sur un réseau de confiance.
MQTT_BIND=127.0.0.1

# ── Alertes e-mail ────────────────────────────────────────────────────────────
# Envoi réel via Nodemailer → Mailhog (serveur SMTP de test local).
# Interface Web Mailhog : http://localhost:8025
ALERT_RECIPIENT_EMAIL=ops-brazil@futurekawa.com
ALERT_SENDER_EMAIL=alertes@futurekawa.com

# ── SMTP (Mailhog en développement, SMTP réel en production) ─────────────────
# En Docker, ces variables sont injectées directement dans le service api.
# Pour un lancement hors Docker (pnpm dev), copier les valeurs ci-dessous :
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# ── Mailhog — ports exposés sur l'hôte ────────────────────────────────────────
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
