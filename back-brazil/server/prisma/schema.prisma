generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lot {
  id            String        @id
  reference     String        @unique
  warehouseId   String
  warehouseName String
  countryCode   String
  productName   String
  producer      String
  harvestDate   DateTime
  storedAt      DateTime
  quantityKg    Int
  measurements  Measurement[]
}

model Measurement {
  id              String   @id
  lotId           String
  measuredAt      DateTime
  temperatureC    Float
  humidityPercent Float
  lot             Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId, measuredAt])
}
