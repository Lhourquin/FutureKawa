generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lot {
  id            String        @id @default(cuid())
  reference     String        @unique
  warehouseId   String
  warehouseName String
  countryCode   String
  productName   String
  producer      String
  harvestDate   DateTime
  storedAt      DateTime
  quantityKg    Int
  measurements  Measurement[]
}

// Une Measurement = un relevé d'un capteur (temperature OU humidite).
// Chaque message MQTT produit exactement une ligne.
model Measurement {
  id         String   @id @default(cuid())
  lotId      String
  sensor     String   // 'temperature' | 'humidity'
  value      Float
  unit       String   // 'C' | '%'
  receivedAt DateTime @default(now())
  lot        Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId, sensor, receivedAt])
}

// Trace brute des messages MQTT, conservée pour débogage.
model SensorLog {
  id         String   @id @default(cuid())
  topic      String
  country    String
  warehouse  String
  sensor     String
  value      Float
  unit       String
  timeserie  Int
  receivedAt DateTime @default(now())

  @@index([country, warehouse, sensor, receivedAt])
}
