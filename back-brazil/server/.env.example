# ─── FutureKawa — Back Brazil — server/.env (lancement hors Docker) ──────────
# Copier ce fichier en .env :  cp .env.example .env
# Les valeurs correspondent à back-brazil/.env.example (PostgreSQL et Mosquitto
# lancés par docker compose). Si elles y sont modifiées, les reporter ici.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL publié par Docker sur 127.0.0.1:POSTGRES_PORT
DATABASE_URL="postgresql://futurekawa_br_user:futurekawa-demo-2025@127.0.0.1:5433/futurekawa_br?schema=public"

# Mosquitto publié par Docker — le port doit être égal à MQTT_PORT
MQTT_URL="mqtt://127.0.0.1:1883"
MQTT_CLIENT_ID="futurekawa-br-backend"
MQTT_MEASUREMENTS_TOPIC="futurekawa/+/+/sensors/+"

PORT=3001

# Alertes e-mail → Mailhog (interface : http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
ALERT_RECIPIENT_EMAIL=ops-brazil@futurekawa.com
ALERT_SENDER_EMAIL=alertes@futurekawa.com
